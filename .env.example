# Private server configuration. Never put keys in VITE_* or commit .env.
SALY_DATA_DIR=./data
# Empty = local SQLite. Supabase/PostgreSQL: use a backend-only DSN with TLS verification.
SALY_DATABASE_URL=
# Optional for first deployment without a private terminal. Generate with manage hash-owner.
SALY_OWNER_PASSWORD_HASH=
SALY_LLM_BASE_URL=https://api.groq.com/openai/v1
# A chave pode ser configurada por bash scripts/connect-model.sh.
# GROQ_API_KEY existente nos Secrets também é reconhecida para Groq, sem copiar seu valor.
SALY_LLM_API_KEY=
# Candidate open-weight model. Confirm availability and free quotas in your provider account.
SALY_MODEL=llama-3.3-70b-versatile
SALY_MAX_OUTPUT_TOKENS=1400
SALY_AGENT_MAX_STEPS=4
SALY_HOST=127.0.0.1
SALY_PORT=8000
SALY_SECURE_COOKIE=0
SALY_MAX_UPLOAD_MB=10
SALY_MAX_DOCUMENTS=50
SALY_MAX_TOTAL_MB=200
SALY_MAX_PAGES=500
SALY_DOC_WORKERS=1
# Optional OpenAI-compatible multilingual embeddings, exactly 384 dimensions.
# Model and immutable revision must identify the same encoder across the whole index.
SALY_EMBEDDING_URL=
SALY_EMBEDDING_API_KEY=
SALY_EMBEDDING_MODEL=
SALY_EMBEDDING_REVISION=
# Optional integrations. No service is contacted until configured/authorized.
SALY_SEARCH_API_KEY=
SALY_WEB_ALLOWED_DOMAINS=
SALY_GITHUB_TOKEN=
SALY_GITHUB_REPOSITORY=dragonlisboa423-dev/nexora
