{
  "name": "SALY Intelligence",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "postCreateCommand": "bash scripts/install.sh",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "SALY (autentica\u00e7\u00e3o obrigat\u00f3ria)",
      "onAutoForward": "silent",
      "visibility": "private"
    },
    "11434": {
      "label": "Ollama \u2014 somente localhost",
      "onAutoForward": "ignore",
      "visibility": "private"
    }
  },
  "remoteEnv": {
    "SALY_SECURE_COOKIE": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
